{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared tier policy (automerge minor/patch/digest, majors PR-only, Actions
  // grouped) lives in the homelab repo. Same owner, same app installation, so
  // the preset is fetchable; only unifi-specific overrides belong below.
  extends: [
    "github>thathaneydude/homelab//renovate/default.json5",
    // MUST come after the preset. The preset extends config:recommended, which
    // pulls in :semanticPrefixFixDepsChoreOthers — that preset sets the commit
    // type through *packageRules* (`fix` for dependencies, `chore` for the
    // rest), and a packageRule beats the top-level `semanticCommitType` below.
    // Without this line the setting is silently ignored: the first live run
    // produced `fix(deps): update module github.com/onsi/gomega` and
    // `chore(deps): update dependency python`, never `build(deps)`.
    ":semanticCommitTypeAll(build)",
  ],

  // The preset turns semantic commits off (most repos use plain imperative
  // subjects); this repo enforces Conventional Commits via .conform.yaml and the
  // `commit lint` CI job, so they go back on here. `build` is an allowed conform
  // type and the Conventional Commits type for dependency changes, and
  // cliff.toml groups it under "Build & CI" — `fix(deps)` would file bumps under
  // "Bug Fixes" and `chore(deps)` would drop them from the changelog entirely.
  //
  // Nothing catches this drifting: .conform.yaml also allows `fix` and `chore`,
  // so `commit lint` passes either way and only the changelog comes out wrong.
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: "deps",

  // Keep go.mod/go.sum consistent with what the drift guard and `go mod verify`
  // expect, and follow v2+ import-path changes instead of opening a PR that
  // cannot compile.
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],

  packageRules: [
    {
      description: "Go version is a coordinated bump — reviewed PR only",
      matchManagers: ["gomod"],
      matchDepNames: ["go", "toolchain"],
      automerge: false,
      prBodyNotes: [
        "⚠️ **Do not merge on its own.** The `go` directive is mirrored by the `go-version:` pins in `.github/workflows/{ci,docs,release,release-on-main,spec-sync}.yml`. Bump those in the same PR or CI builds on a different toolchain than the module declares.",
      ],
    },
    {
      // These two produce the artifacts the drift guard checks: oapi-codegen
      // writes lib/**/client.gen.go, counterfeiter writes the fakes. Bumping
      // either rewrites generated code, so the PR fails the drift guard until
      // someone regenerates — and the regenerated diff is far too large to be
      // reviewed as part of a routine dependency bump. #23 (oapi-codegen
      // v2.7 → v2.8) changed 17,329 lines across the two clients.
      //
      // Same reasoning as the `go` directive above: a bump whose blast radius
      // is the whole generated surface rides a reviewed PR, not automation.
      description: "Code generators change committed output — reviewed PR only",
      matchManagers: ["gomod"],
      matchDepNames: [
        "github.com/oapi-codegen/oapi-codegen/v2",
        "github.com/maxbrunsfeld/counterfeiter/v6",
      ],
      automerge: false,
      prBodyNotes: [
        "⚠️ **Do not merge on its own.** This bumps a code generator, so the committed output under `lib/**` (and `internalfakes/`) no longer matches what it produces — CI's drift guard will fail until it is regenerated. Run `just sync && just gen && go generate ./...` on this branch, commit the result, and review the generated diff before merging.",
      ],
    },
  ],
}
